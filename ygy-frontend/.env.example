# 개발 서버가 /api와 /docs 요청을 전달할 ygy-backend 주소
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# 프론트와 백엔드를 서로 다른 Origin으로 배포할 때만 지정
# /api를 붙이지 않고 Origin만 입력
# VITE_API_BASE_URL=https://api.example.com

# 화면은 아래 실제 테스트 ID로 열립니다. URL 쿼리(orderId/storeId/riderId)가 있으면 그 값이 우선합니다.
VITE_DEFAULT_ORDER_ID=1
VITE_DEFAULT_STORE_ID=892
VITE_DEFAULT_RIDER_ID=rider_102

# 백엔드의 URL만 표준 계약과 다를 때 JSON 객체로 경로를 덮어씁니다.
# 지원 키: customer, customerCancel, merchant, merchantCookTime, riders, rider,
# riderProfile, riderPickup, riderComplete, stores, explanationContext,
