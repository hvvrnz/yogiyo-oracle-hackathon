# 개발 서버가 /api, /ws, /docs 요청을 전달할 ygy-backend 주소
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# 프론트와 백엔드를 서로 다른 Origin으로 배포할 때만 지정
# /api를 붙이지 않고 Origin만 입력
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com

# 화면은 아래 기본 ID로 열립니다. URL 쿼리(customerId/storeId/riderId)가 있으면 그 값이 우선합니다.
# VITE_DEFAULT_CUSTOMER_ID=C-001
# VITE_DEFAULT_STORE_ID=S-001
# VITE_DEFAULT_RIDER_ID=R-001

# 백엔드의 URL만 표준 계약과 다를 때 JSON 객체로 경로를 덮어씁니다.
# 지원 키: customer, orders, merchant, merchantOrderAction, rider,
# riderOfferResponse, riderPickup, riderDeliver, explanation, mapsConfig,
# demoState, demoDispatchCalculate, demoReset, demoWeather, demoStrategy,
# demoNextStep, demoSimulation, websocket
# 예: VITE_API_PATHS={"customer":"/v1/customers/:customerId/orders/current","websocket":"/v1/ws/:role/:entityId"}
# websocket 경로에는 :role, :entityId를 사용할 수 있습니다.
